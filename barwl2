<!DOCTYPE html>
<html lang="it">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Brawl Showdown - Bots & Cubes</title>
    <style>
        body { margin: 0; background: #1a1a1a; color: white; font-family: 'Arial', sans-serif; overflow: hidden; touch-action: none; }
        #ui-top { position: absolute; top: 10px; width: 100%; text-align: center; z-index: 10; pointer-events: none; }
        .stat { font-size: 20px; font-weight: bold; color: #ffce00; text-shadow: 2px 2px #000; display: inline-block; margin: 0 15px; }
        
        /* Controlli Mobile/Bottoni */
        #controls { position: absolute; bottom: 30px; width: 100%; display: flex; justify-content: space-around; z-index: 20; }
        .btn { width: 70px; height: 70px; background: rgba(255,255,255,0.2); border: 3px solid #fff; border-radius: 50%; display: flex; justify-content: center; align-items: center; font-weight: bold; user-select: none; cursor: pointer; }
        .btn:active { background: rgba(255,255,255,0.5); }
        #move-stick { background: rgba(52, 152, 219, 0.3); }
        #shoot-btn { background: rgba(231, 76, 60, 0.4); border-color: #e74c3c; }

        canvas { display: block; background-color: #5d8a37; }
    </style>
</head>
<body>

    <div id="ui-top">
        <div class="stat" id="cubes-val">💎 Power Cubes: 0</div>
        <div class="stat" id="brawlers-val">👥 Nemici: 5</div>
    </div>

    <div id="controls">
        <div class="btn" id="move-stick">WASD</div>
        <div class="btn" id="shoot-btn">SPARA</div>
    </div>

    <canvas id="game"></canvas>

<script>
    const canvas = document.getElementById('game');
    const ctx = canvas.getContext('2d');
    
    // Configurazione
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
    const WORLD = 2500;
    let stormRadius = 1800;
    let brawlersCount = 6; // 1 Player + 5 Bot

    const player = {
        x: 1250, y: 1250, r: 25, hp: 4000, maxHp: 4000, 
        cubes: 0, speed: 6, bullets: [], lastShot: 0
    };

    const bots = [];
    const boxes = [];
    const loot = []; // Power cubes a terra
    const keys = {};

    // Inizializzazione Bot
    for(let i=0; i<5; i++) {
        bots.push({
            x: Math.random() * WORLD, y: Math.random() * WORLD,
            hp: 3500, maxHp: 3500, cubes: 0, color: '#e74c3c',
            bullets: [], lastShot: 0, targetX: Math.random() * WORLD, targetY: Math.random() * WORLD
        });
    }

    // Inizializzazione Casse
    for(let i=0; i<20; i++) {
        boxes.push({ x: Math.random()*(WORLD-100)+50, y: Math.random()*(WORLD-100)+50, hp: 1500 });
    }

    // Eventi
    window.onkeydown = e => keys[e.key.toLowerCase()] = true;
    window.onkeyup = e => keys[e.key.toLowerCase()] = false;
    document.getElementById('shoot-btn').addEventListener('pointerdown', () => playerShoot());
    window.addEventListener('mousedown', () => playerShoot());

    function playerShoot() {
        const now = Date.now();
        if(now - player.lastShot < 400) return;
        player.lastShot = now;

        // Mira verso il mouse o il centro se mobile
        const angle = Math.atan2(mouseY - canvas.height/2, mouseX - canvas.width/2);
        player.bullets.push({ x: player.x, y: player.y, vx: Math.cos(angle)*15, vy: Math.sin(angle)*15, d: 0 });
    }

    let mouseX = 0, mouseY = 0;
    window.onmousemove = e => { mouseX = e.clientX; mouseY = e.clientY; };

    function update() {
        // Movimento Player
        if(keys['w'] && player.y > 0) player.y -= player.speed;
        if(keys['s'] && player.y < WORLD) player.y += player.speed;
        if(keys['a'] && player.x > 0) player.x -= player.speed;
        if(keys['d'] && player.x < WORLD) player.x += player.speed;

        // Tempesta più lenta
        if(stormRadius > 200) stormRadius -= 0.15;
        
        // Danno tempesta
        const distToCenter = Math.hypot(player.x - WORLD/2, player.y - WORLD/2);
        if(distToCenter > stormRadius) player.hp -= 2;

        // Logica Bot
        bots.forEach((bot, index) => {
            if(bot.hp <= 0) return;

            // IA Semplice: Segui il player se vicino
            const dToP = Math.hypot(player.x - bot.x, player.y - bot.y);
            if(dToP < 500) {
                bot.x += (player.x - bot.x) * 0.01;
                bot.y += (player.y - bot.y) * 0.01;
                
                // Bot spara
                if(Date.now() - bot.lastShot > 1000) {
                    const angle = Math.atan2(player.y - bot.y, player.x - bot.x);
                    bot.bullets.push({ x: bot.x, y: bot.y, vx: Math.cos(angle)*10, vy: Math.sin(angle)*10, d: 0 });
                    bot.lastShot = Date.now();
                }
            }

            // Proiettili Bot
            bot.bullets.forEach((b, bi) => {
                b.x += b.vx; b.y += b.vy; b.d += 10;
                if(Math.hypot(b.x - player.x, b.y - player.y) < 25) {
                    player.hp -= (400 + bot.cubes * 50);
                    bot.bullets.splice(bi, 1);
                }
                if(b.d > 500) bot.bullets.splice(bi, 1);
            });
        });

        // Proiettili Player e Collisioni
        player.bullets.forEach((b, bi) => {
            b.x += b.vx; b.y += b.vy; b.d += 15;
            
            // Colpisce Casse
            boxes.forEach(box => {
                if(box.hp > 0 && Math.hypot(b.x - box.x, b.y - box.y) < 30) {
                    box.hp -= (500 + player.cubes * 100);
                    player.bullets.splice(bi, 1);
                    if(box.hp <= 0) loot.push({x: box.x, y: box.y});
                }
            });

            // Colpisce Bot
            bots.forEach(bot => {
                if(bot.hp > 0 && Math.hypot(b.x - bot.x, b.y - bot.y) < 30) {
                    bot.hp -= (500 + player.cubes * 100);
                    player.bullets.splice(bi, 1);
                    if(bot.hp <= 0) {
                        for(let k=0; k<3; k++) loot.push({x: bot.x + Math.random()*20, y: bot.y+ Math.random()*20});
                        brawlersCount--;
                        document.getElementById('brawlers-val').innerText = `👥 Nemici: ${brawlersCount - 1}`;
                    }
                }
            });

            if(b.d > 600) player.bullets.splice(bi, 1);
        });

        // Raccogli Power Cubes
        loot.forEach((cube, li) => {
            if(Math.hypot(player.x - cube.x, player.y - cube.y) < 40) {
                player.cubes++;
                player.maxHp += 400;
                player.hp += 400;
                loot.splice(li, 1);
                document.getElementById('cubes-val').innerText = `💎 Power Cubes: ${player.cubes}`;
            }
        });
    }

    function draw() {
        ctx.clearRect(0,0, canvas.width, canvas.height);
        ctx.save();
        ctx.translate(canvas.width/2 - player.x, canvas.height/2 - player.y);

        // Disegna Tempesta
        ctx.beginPath();
        ctx.arc(WORLD/2, WORLD/2, stormRadius, 0, Math.PI*2);
        ctx.lineWidth = 2000;
        ctx.strokeStyle = "rgba(100, 255, 100, 0.2)"; // Gas verde
        ctx.stroke();

        // Power Cubes a terra
        ctx.fillStyle = "#00f2ff";
        loot.forEach(l => {
            ctx.fillRect(l.x-10, l.y-10, 20, 20);
        });

        // Casse
        ctx.fillStyle = "#e67e22";
        boxes.forEach(b => {
            if(b.hp > 0) ctx.fillRect(b.x-25, b.y-25, 50, 50);
        });

        // Bots
        bots.forEach(bot => {
            if(bot.hp <= 0) return;
            ctx.fillStyle = bot.color;
            ctx.beginPath(); ctx.arc(bot.x, bot.y, 25, 0, Math.PI*2); ctx.fill();
            // HP Bot
            ctx.fillStyle = "red"; ctx.fillRect(bot.x-25, bot.y-40, 50, 5);
            ctx.fillStyle = "lime"; ctx.fillRect(bot.x-25, bot.y-40, (bot.hp/bot.maxHp)*50, 5);
            // Proiettili Bot
            ctx.fillStyle = "white";
            bot.bullets.forEach(b => { ctx.beginPath(); ctx.arc(b.x, b.y, 5, 0, Math.PI*2); ctx.fill(); });
        });

        // Player
        ctx.fillStyle = "#3498db";
        ctx.beginPath(); ctx.arc(player.x, player.y, 25, 0, Math.PI*2); ctx.fill();
        
        // Proiettili Player
        ctx.fillStyle = "#f1c40f";
        player.bullets.forEach(b => { ctx.beginPath(); ctx.arc(b.x, b.y, 8, 0, Math.PI*2); ctx.fill(); });

        // HP Player
        ctx.fillStyle = "red"; ctx.fillRect(player.x-30, player.y-45, 60, 8);
        ctx.fillStyle = "#2ecc71"; ctx.fillRect(player.x-30, player.y-45, (player.hp/player.maxHp)*60, 8);

        ctx.restore();

        if(player.hp > 0) {
            update();
            requestAnimationFrame(draw);
        } else {
            ctx.fillStyle = "black"; ctx.fillRect(0,0, canvas.width, canvas.height);
            ctx.fillStyle = "white"; ctx.font = "40px Arial"; ctx.fillText("GAME OVER", canvas.width/2-100, canvas.height/2);
        }
    }

    draw();
</script>
</body>
</html>
